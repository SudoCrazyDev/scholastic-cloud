---
import '../styles/global.css';
import ProductUiSection from '../components/ProductUiSection.astro';
import FeaturesMegaMenu from '../components/FeaturesMegaMenu.astro';
import FeaturesMobileNav from '../components/FeaturesMobileNav.astro';
import LeadForm from '../components/LeadForm.astro';
import StickyCta from '../components/StickyCta.astro';
import LenisSmooth from '../components/react/LenisSmooth';
import HeroMotion from '../components/react/HeroMotion';
import MotionSection from '../components/react/MotionSection';
import { campusScenes, featureGroups } from '../data/features';

const totalCapabilities = featureGroups.reduce((count, group) => count + group.items.length, 0);
---

<html lang="en-PH">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Scholastic Cloud is school management software for Philippine K to 12 institutions — DepEd-aligned grades and SF9, peso cashiering, attendance, HR and payroll, in one platform." />
		<meta name="theme-color" content="#FBFBF9" />
		<title>Scholastic Cloud — School management for Philippine K to 12</title>
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1770945751834620" crossorigin="anonymous"></script>
	</head>
	<body class="bg-paper text-ink-800">
		<LenisSmooth client:load />
		<div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>
		<!-- Navigation -->
		<nav class="fixed top-0 w-full z-50 border-b border-ink-200/80 bg-paper/85 backdrop-blur-xl transition-shadow duration-300" id="navbar">
			<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" id="nav-inner">
				<div class="flex justify-between items-center h-16 md:h-[4.25rem]">
					<a href="#" class="flex items-center gap-3 group">
						<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-pine-700 ring-1 ring-pine-800/20 transition-transform group-hover:scale-[1.03]">
							<svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"></path>
							</svg>
						</div>
						<span class="font-display text-xl tracking-tight text-ink-900">Scholastic Cloud</span>
					</a>
					<div class="hidden md:flex items-center gap-8 text-sm font-medium lg:gap-10">
						<a href="#showcase" class="text-ink-600 hover:text-pine-800 transition-colors">Capabilities</a>
						<a href="#product-ui" class="text-ink-600 hover:text-pine-800 transition-colors">Preview</a>
						<button
							type="button"
							id="features-mega-trigger"
							class="group inline-flex items-center gap-1.5 rounded text-ink-600 transition-colors hover:text-pine-800 aria-expanded:text-pine-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pine-500 focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
							aria-expanded="false"
							aria-controls="features-mega"
							aria-haspopup="true"
						>
							Features
							<svg class="h-3.5 w-3.5 transition-transform duration-200 group-aria-expanded:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
							</svg>
						</button>
						<a href="#campus" class="text-ink-600 hover:text-pine-800 transition-colors">On campus</a>
						<a href="#solution" class="text-ink-600 hover:text-pine-800 transition-colors">Timeline</a>
						<a href="#benefits" class="text-ink-600 hover:text-pine-800 transition-colors">Why us</a>
						<a href="#cta" class="magnetic rounded-full bg-pine-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-pine-800">Get started</a>
					</div>
					<button type="button" id="nav-toggle" class="md:hidden inline-flex items-center justify-center rounded-lg p-2 text-ink-600 hover:bg-paper-alt hover:text-ink-900" aria-expanded="false" aria-controls="mobile-menu">
						<span class="sr-only">Open menu</span>
						<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="nav-icon-open">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
						</svg>
						<svg class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="nav-icon-close">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
				<div id="mobile-menu" class="hidden md:hidden border-t border-ink-200 py-4">
					<div class="flex flex-col gap-1 text-sm font-medium">
						<a href="#showcase" class="rounded-lg px-3 py-2 text-ink-800 hover:bg-paper-alt">Capabilities</a>
						<a href="#product-ui" class="rounded-lg px-3 py-2 text-ink-800 hover:bg-paper-alt">Preview</a>
						<FeaturesMobileNav />
						<a href="#campus" class="rounded-lg px-3 py-2 text-ink-800 hover:bg-paper-alt">On campus</a>
						<a href="#solution" class="rounded-lg px-3 py-2 text-ink-800 hover:bg-paper-alt">Timeline</a>
						<a href="#benefits" class="rounded-lg px-3 py-2 text-ink-800 hover:bg-paper-alt">Why us</a>
						<a href="#cta" class="mt-2 rounded-full bg-pine-700 px-4 py-3 text-center font-semibold text-white">Get started</a>
					</div>
				</div>

				<FeaturesMegaMenu />
			</div>
		</nav>

		<!-- Hero -->
		<section class="relative min-h-[100svh] flex items-center overflow-hidden pt-20 pb-24 px-4 sm:px-6 lg:px-8 bg-paper">
			<div id="hero-photo" class="hero-photo" style="background-image:url('/images/campus-hero-light.jpg')" aria-hidden="true"></div>
			<div class="hero-wash" aria-hidden="true"></div>
			<div class="grain opacity-[0.18]" aria-hidden="true"></div>
			<div class="hero-glow pointer-events-none absolute -left-32 top-1/4 h-96 w-96 rounded-full bg-pine-200/40 blur-3xl" data-parallax="24"></div>
			<div class="hero-glow pointer-events-none absolute right-1/4 -bottom-10 h-[26rem] w-[26rem] rounded-full bg-marigold-200/30 blur-3xl" data-parallax="-32"></div>

			<HeroMotion client:load>
				<div class="lg:col-span-6">
					<p class="eyebrow mb-5">For Philippine K to 12 schools</p>
					<h1 class="font-display text-4xl leading-[1.06] text-ink-950 sm:text-5xl lg:text-6xl xl:text-[3.75rem] text-balance">
						School operations,
						<span class="text-pine-700"> in daylight.</span>
					</h1>
					<p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600">
						One workspace for DepEd-aligned grades, peso cashiering, attendance and payroll — built for Philippine schools, from the principal’s office to the advisory class.
					</p>
					<div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
						<a href="#cta" class="magnetic inline-flex items-center justify-center rounded-full bg-pine-700 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-pine-900/15 transition hover:bg-pine-800">
							Start a trial
						</a>
						<a href="#showcase" class="magnetic group inline-flex items-center justify-center gap-2 rounded-full border border-ink-300 bg-white/70 px-8 py-3.5 text-base font-semibold text-ink-800 backdrop-blur transition hover:border-pine-300 hover:bg-white">
							Explore capabilities
							<svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
						</a>
					</div>
					<dl class="mt-14 grid grid-cols-3 gap-6 border-t border-ink-200 pt-10 sm:max-w-md">
						<div>
							<dt class="text-xs font-medium uppercase tracking-wider text-ink-500">Curriculum</dt>
							<dd class="mt-1 font-display text-xl text-ink-900 sm:text-2xl">K to 12</dd>
						</div>
						<div>
							<dt class="text-xs font-medium uppercase tracking-wider text-ink-500">Access</dt>
							<dd class="mt-1 font-display text-xl text-ink-900 sm:text-2xl">Role-based</dd>
						</div>
						<div>
							<dt class="text-xs font-medium uppercase tracking-wider text-ink-500">Reporting</dt>
							<dd class="mt-1 font-display text-xl text-ink-900 sm:text-2xl">DepEd SF9</dd>
						</div>
					</dl>
				</div>

				<div class="lg:col-span-6">
					<div class="float-soft relative mx-auto max-w-lg lg:max-w-none">
						<div class="interactive-card relative overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-2xl shadow-pine-950/10">
							<div class="flex items-center gap-2 border-b border-ink-200 bg-paper-sunk px-4 py-3">
								<span class="h-2.5 w-2.5 rounded-full bg-rose-300"></span>
								<span class="h-2.5 w-2.5 rounded-full bg-marigold-300"></span>
								<span class="h-2.5 w-2.5 rounded-full bg-pine-300"></span>
								<span class="ml-3 flex-1 truncate rounded-md bg-white px-3 py-1 text-[11px] text-ink-500 ring-1 ring-ink-200">app.scholasticcloud — Dashboard</span>
							</div>
							<div class="grid gap-0 sm:grid-cols-[7.5rem_1fr]">
								<div class="hidden border-r border-ink-200 bg-paper-alt p-3 sm:block">
									<div class="space-y-2">
										<div class="h-2 w-full rounded bg-pine-400/70"></div>
										<div class="h-2 w-4/5 rounded bg-ink-300"></div>
										<div class="h-2 w-3/5 rounded bg-ink-200"></div>
										<div class="mt-6 h-2 w-full rounded bg-ink-200"></div>
										<div class="h-2 w-full rounded bg-ink-200"></div>
										<div class="h-2 w-2/3 rounded bg-ink-200"></div>
									</div>
								</div>
								<div class="p-5 sm:p-6">
									<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
										<div>
											<p class="text-xs font-medium uppercase tracking-wider text-ink-500">Today</p>
											<p class="font-display text-2xl text-ink-900">Academic overview</p>
										</div>
										<span class="rounded-full border border-pine-200 bg-pine-50 px-3 py-1 text-xs font-semibold text-pine-700">Live sync</span>
									</div>
									<div class="grid gap-3 sm:grid-cols-2">
										<div class="rounded-xl border border-pine-100 bg-pine-50/70 p-4">
											<p class="text-xs text-ink-500">Consolidated grades</p>
											<p class="mt-2 font-display text-3xl text-ink-900">SF9 · Q3</p>
											<div class="mt-3 h-1.5 overflow-hidden rounded-full bg-pine-100">
												<div class="h-full w-[72%] rounded-full bg-pine-500"></div>
											</div>
										</div>
										<div class="rounded-xl border border-ink-200 bg-paper-alt p-4">
											<p class="text-xs text-ink-500">Collections</p>
											<p class="mt-2 font-display text-3xl text-ink-900">₱ · Cashier</p>
											<p class="mt-2 text-xs text-ink-500">Receipts &amp; ledger in one flow</p>
										</div>
									</div>
									<div class="mt-4 grid grid-cols-3 gap-2">
										<div class="rounded-lg border border-ink-200 bg-white p-3 text-center">
											<p class="text-[10px] uppercase tracking-wider text-ink-400">Gate</p>
											<p class="mt-1 text-sm font-semibold text-ink-800">In / Out</p>
										</div>
										<div class="rounded-lg border border-ink-200 bg-white p-3 text-center">
											<p class="text-[10px] uppercase tracking-wider text-ink-400">Certs</p>
											<p class="mt-1 text-sm font-semibold text-ink-800">Builder</p>
										</div>
										<div class="rounded-lg border border-ink-200 bg-white p-3 text-center">
											<p class="text-[10px] uppercase tracking-wider text-ink-400">Forms</p>
											<p class="mt-1 text-sm font-semibold text-ink-800">Custom</p>
										</div>
									</div>
									<div class="mt-4 overflow-hidden rounded-lg border border-ink-200">
										<div class="flex items-center justify-between border-b border-ink-200 bg-paper-sunk px-3 py-2">
											<span class="text-[10px] font-medium uppercase tracking-wider text-ink-500">Recent activity</span>
											<span class="text-[10px] font-semibold text-marigold-700">Live</span>
										</div>
										<table class="w-full text-left text-[10px] text-ink-700">
											<tbody class="divide-y divide-ink-100">
												<tr class="bg-paper-alt/60">
													<td class="px-3 py-2">Enrollment sync</td>
													<td class="px-3 py-2 text-right tabular-nums font-semibold text-pine-700">OK</td>
												</tr>
												<tr>
													<td class="px-3 py-2">Grade upload · Q3</td>
													<td class="px-3 py-2 text-right tabular-nums text-ink-500">12 teachers</td>
												</tr>
											</tbody>
										</table>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</HeroMotion>
		</section>

		<!-- Trust strip -->
		<section aria-label="At a glance" class="border-y border-ink-200 bg-paper-alt">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-2 divide-x divide-ink-200 md:grid-cols-4">
					<div class="px-4 py-6 text-center md:py-7">
						<p class="font-display text-2xl text-ink-900 sm:text-3xl" data-countup="42">0</p>
						<p class="mt-1 text-xs font-medium uppercase tracking-wider text-ink-500">Permissioned modules</p>
					</div>
					<div class="px-4 py-6 text-center md:py-7">
						<p class="font-display text-2xl text-ink-900 sm:text-3xl">K to 12</p>
						<p class="mt-1 text-xs font-medium uppercase tracking-wider text-ink-500">Kinder to Senior High</p>
					</div>
					<div class="px-4 py-6 text-center md:py-7">
						<p class="font-display text-2xl text-ink-900 sm:text-3xl">DepEd</p>
						<p class="mt-1 text-xs font-medium uppercase tracking-wider text-ink-500">Aligned school forms</p>
					</div>
					<div class="px-4 py-6 text-center md:py-7">
						<p class="font-display text-2xl text-ink-900 sm:text-3xl">Multi-campus</p>
						<p class="mt-1 text-xs font-medium uppercase tracking-wider text-ink-500">One login per staff</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Capabilities bento -->
		<MotionSection client:visible id="showcase" className="relative scroll-mt-24 border-t border-ink-200 bg-white py-24 px-4 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-7xl">
				<div class="reveal mb-14 max-w-3xl">
					<p class="eyebrow">01 — Capabilities</p>
					<h2 class="mt-3 font-display text-4xl tracking-tight text-ink-900 sm:text-5xl text-balance">
						Built around how Philippine schools actually work
					</h2>
					<p class="mt-4 text-lg text-ink-600">
						Real modules from the platform — SF9 and consolidated grades, peso cashiering, gate kiosks, certificates and assessments — connected in one place.
					</p>
				</div>

				<div class="reveal grid gap-4 md:grid-cols-6 lg:grid-cols-12 lg:gap-5">
					<article class="bento-card group reveal-child md:col-span-6 lg:col-span-7 lg:row-span-2 min-h-[280px] bg-white p-8">
						<div class="flex h-full flex-col justify-between">
							<div>
								<span class="inline-flex rounded-full bg-pine-100 px-3 py-1 text-xs font-semibold text-pine-800">Finance & cashiering</span>
								<h3 class="mt-4 font-display text-2xl text-ink-900 sm:text-3xl">Fees, collections, receipts</h3>
								<p class="mt-3 max-w-lg text-ink-600 leading-relaxed">
									Configure school fees, discounts, cashiering, and collections with receipt builder and ledger views—so the business office stays aligned with the classroom.
								</p>
							</div>
							<div class="mt-8 flex flex-wrap gap-2">
								<span class="rounded-lg border border-ink-200 bg-white px-2.5 py-1 text-xs font-medium text-ink-600">Cashiering</span>
								<span class="rounded-lg border border-ink-200 bg-white px-2.5 py-1 text-xs font-medium text-ink-600">Collections</span>
								<span class="rounded-lg border border-ink-200 bg-white px-2.5 py-1 text-xs font-medium text-ink-600">Receipt builder</span>
								<span class="rounded-lg border border-ink-200 bg-white px-2.5 py-1 text-xs font-medium text-ink-600">Student ledger</span>
							</div>
							<div class="mt-8 border-t border-ink-100 pt-6">
								<p class="mb-3 text-[10px] font-semibold uppercase tracking-wider text-ink-400">UI preview</p>
								<div class="mock-browser mock-browser-sm overflow-hidden shadow-md">
									<div class="mock-browser-chrome py-2">
										<span class="mock-dot bg-red-400"></span>
										<span class="mock-dot bg-amber-400"></span>
										<span class="mock-dot bg-emerald-400"></span>
										<span class="mock-url text-[9px]">…/finance/cashiering</span>
									</div>
									<div class="mock-browser-body py-3">
										<div class="flex gap-2 overflow-hidden rounded-md border border-ink-200 bg-white">
											<div class="min-w-0 flex-1 divide-y divide-ink-100 text-[9px]">
												<div class="flex justify-between gap-2 px-2 py-1 font-medium text-ink-500">
													<span>OR</span><span class="tabular-nums text-ink-800">2025-0142</span>
												</div>
												<div class="flex justify-between gap-2 px-2 py-1 text-ink-700">
													<span class="truncate">Reyes, Ana</span><span class="shrink-0 font-semibold text-pine-700">₱4,250</span>
												</div>
											</div>
											<div class="w-20 shrink-0 bg-pine-50 px-2 py-2 text-center">
												<p class="text-[8px] font-medium uppercase text-pine-600">Shift</p>
												<p class="font-display text-sm text-ink-900">₱48.9k</p>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</article>

					<article class="bento-card group reveal-child md:col-span-6 lg:col-span-5 bg-white p-7">
						<span class="inline-flex rounded-full bg-marigold-100 px-3 py-1 text-xs font-semibold text-marigold-800">Grades & records</span>
						<h3 class="mt-4 font-display text-xl text-ink-900">Consolidated grades & SF9</h3>
						<p class="mt-2 text-sm leading-relaxed text-ink-600">
							Section-level consolidation, core values and proficiency marking, and SF9 generation per academic year.
						</p>
					</article>

					<article class="bento-card group reveal-child border-pine-200 bg-pine-50/60 p-7 md:col-span-3 lg:col-span-5">
						<span class="inline-flex rounded-full bg-pine-100 px-3 py-1 text-xs font-semibold text-pine-800">Gate &amp; attendance</span>
						<h3 class="mt-4 font-display text-xl text-ink-900">Kiosk enter / exit</h3>
						<p class="mt-2 text-sm leading-relaxed text-ink-600">
							Public gate flows plus teacher attendance grids and realtime indicators for daily operations.
						</p>
					</article>

					<article class="bento-card group reveal-child md:col-span-3 lg:col-span-8 bg-pine-50/50 p-7">
						<span class="inline-flex rounded-full bg-pine-100 px-3 py-1 text-xs font-semibold text-pine-900">Teaching</span>
						<h3 class="mt-4 font-display text-xl text-ink-900">Assigned subjects & lesson plans</h3>
						<p class="mt-2 text-sm leading-relaxed text-ink-600">
							Class records, assessments, calendars, and AI-assisted planning—everything tied to sections and subjects.
						</p>
					</article>

					<article class="bento-card group reveal-child md:col-span-3 lg:col-span-4 bg-white p-7">
						<span class="inline-flex rounded-full bg-marigold-100 px-3 py-1 text-xs font-semibold text-marigold-800">Certificates</span>
						<h3 class="mt-4 font-display text-xl text-ink-900">Visual certificate builder</h3>
						<p class="mt-2 text-sm text-ink-600">Design, publish, and manage certificates without leaving the app.</p>
					</article>

					<article class="bento-card group reveal-child md:col-span-3 lg:col-span-6 bg-white p-7">
						<span class="inline-flex rounded-full bg-sky-100 px-3 py-1 text-xs font-semibold text-sky-900">Forms</span>
						<h3 class="mt-4 font-display text-xl text-ink-900">Custom form builder</h3>
						<p class="mt-2 text-sm text-ink-600">Drag-and-drop forms for enrollment, surveys, and internal workflows.</p>
					</article>

					<article class="bento-card group reveal-child md:col-span-6 lg:col-span-6 bg-white p-7">
						<span class="inline-flex rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-900">Students & assessments</span>
						<h3 class="mt-4 font-display text-xl text-ink-900">Learner portal</h3>
						<p class="mt-2 text-sm text-ink-600">
							Learners sit assessments, view subjects, follow their own balance, and pay through Maya — role-aware and secure.
						</p>
					</article>
				</div>
			</div>
		</MotionSection>

		<ProductUiSection />

		<!-- Modules timeline -->
		<MotionSection client:visible id="solution" className="relative section-padding scroll-mt-24 border-t border-ink-200 bg-paper-alt overflow-hidden">
			<div class="pointer-events-none absolute inset-0">
				<div class="absolute top-20 left-0 h-96 w-96 rounded-full bg-pine-200/25 blur-3xl"></div>
				<div class="absolute bottom-20 right-0 h-96 w-96 rounded-full bg-marigold-200/25 blur-3xl"></div>
			</div>

			<div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="mb-14 max-w-3xl reveal reveal-child">
					<p class="eyebrow">02 — Timeline</p>
					<h2 class="mt-3 font-display text-4xl tracking-tight text-ink-900 sm:text-5xl text-balance">
