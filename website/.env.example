# ---------------------------------------------------------------------------
# Lead funnel delivery
# ---------------------------------------------------------------------------
#
# Set AT LEAST ONE of these. With neither, the form on the landing page renders
# a visible amber warning and refuses to accept submissions — deliberately, so a
# form that silently drops leads cannot reach production unnoticed.
#
# Both are PUBLIC_* because Astro only exposes variables with that prefix to the
# browser. Never put a secret here: anything PUBLIC_ ships in the page source.

# Preferred. Any URL that accepts a JSON POST and returns 2xx.
# The body is:
#   {
#     "school": "Sacred Heart Academy",
#     "schoolType": "private-k12",
#     "learners": "500-1500",
#     "areas": ["finance", "hr"],       // ids from src/data/features.ts
#     "timeline": "this-year",
#     "name": "...", "role": "principal",
#     "email": "...", "mobile": "...", "notes": "...",
#     "pageUrl": "...", "referrer": "...", "submittedAt": "ISO-8601"
#   }
# The endpoint must send CORS headers allowing the site origin.
PUBLIC_LEAD_ENDPOINT=

# Fallback. When no endpoint is set the submit button composes a message to this
# address in the visitor's mail client instead. Also offered as a recovery link
# if a POST to the endpoint fails.
PUBLIC_LEAD_EMAIL=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# The form pushes funnel_view / funnel_step / funnel_submit / funnel_success /
# funnel_error to window.dataLayer and gtag if either is present, and always
# dispatches a `sc:funnel` CustomEvent on document. Nothing here to configure —
# add your GTM or GA4 snippet to src/pages/index.astro and the events flow.
