# ── ScholasticCloud SMS Gateway agent ──────────────────────────────────────
# Copy to `.env` and fill in. On first run, pair the kiosk (see README):
#   npm run pair -- <PAIRING_CODE>
# which writes SMS_GATEWAY_TOKEN back into this file.

# Portal API base URL (must include /api). Use the tenant's API host.
API_BASE_URL=https://api.scholastic.cloud/api

# Long-lived per-gateway token. Left blank until you pair; the agent writes it.
SMS_GATEWAY_TOKEN=

# Serial port of the modem's AT command interface.
# Leave blank to auto-detect (probes candidate ports with `AT` -> `OK`).
#   Linux examples: /dev/ttyUSB0, /dev/serial/by-id/usb-...-if02
#   Windows examples: COM3, COM4
SERIAL_PORT=
SERIAL_BAUD=115200

# SMS encoding mode: "pdu" (recommended — Unicode + long messages) or "text".
SMS_MODE=pdu

# Poll/heartbeat cadence (milliseconds).
OUTBOX_POLL_MS=5000
INBOX_POLL_MS=10000
HEARTBEAT_MS=45000

# How many outbound messages to claim per poll.
OUTBOX_BATCH=10

# Optional: USSD code to query prepaid balance (carrier-specific), e.g. *143#.
# Leave blank to skip balance reporting.
USSD_BALANCE_CODE=

# Log level: debug | info | warn | error
LOG_LEVEL=info
