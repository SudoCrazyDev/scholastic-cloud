[Unit]
Description=ScholasticCloud SMS Gateway agent
After=network-online.target
Wants=network-online.target
# Never let a crash-loop permanently ban the unit ("start request repeated too
# quickly"). With the interval at 0 the start-limit is disabled and Restart=always
# always applies.
StartLimitIntervalSec=0

[Service]
Type=simple
# Adjust WorkingDirectory/User to your install location.
WorkingDirectory=/opt/sms_gateway
ExecStart=/usr/bin/node /opt/sms_gateway/dist/index.js
Restart=always
RestartSec=5
User=smsgw
# The modem device must be readable/writable by this user (dialout group).
SupplementaryGroups=dialout
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
